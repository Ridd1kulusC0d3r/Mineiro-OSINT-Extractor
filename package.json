{
  "name": "mineiro-username-intelligence",
  "private": false,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "registry:stats": "tsx scripts/registry-stats.ts",
    "registry:validate": "tsx scripts/registry-validate.ts",
    "demo": "tsx scripts/demo-benchmark.ts",
    "manual:validate": "node scripts/validate-manual.mjs",
    "intelligence:test": "tsx scripts/intelligence-smoke.ts",
    "colab:validate": "node scripts/validate-colab.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "check": "npm run brand:validate && npm run registry:validate && npm run lint && npm run demo && npm run intelligence:test && npm run manual:validate && npm run colab:validate && npm run docs:validate && npm run build",
    "brand:validate": "node scripts/validate-brand.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "OSINT Investigation Workbench for public username presence, evidence review, cautious correlation and auditable local reporting."
}
